  "info": {
    "title": "Stickup API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid"
      }
    },
    "schemas": {
      "OfferDto": {
        "type": "object",
        "properties": {
          "packSize": {
            "type": "number"
          },
          "freeStickerCount": {
            "type": "number"
          },
          "baseGenerations": {
            "type": "number"
          },
          "referralBonusGenerations": {
            "type": "number"
          },
          "referralUnlockEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "packSize",
          "freeStickerCount",
          "baseGenerations",
          "referralBonusGenerations",
          "referralUnlockEnabled"
        ]
      },
      "EmailAuthDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": ["email", "password"]
      },
      "TelegramWebAppAuthDto": {
        "type": "object",
        "properties": {
          "initData": {
            "type": "string",
            "description": "Raw initData string from Telegram WebApp",
            "maxLength": 4096
          }
        },
        "required": ["initData"]
      }
    }
  }
}
